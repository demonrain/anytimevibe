NODE_ENV=production
PORT=8787
DOMAIN=vibe.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://anytimevibe:change-me@postgres:5432/anytimevibe
SETUP_TOKEN=replace-with-a-long-random-token
COOKIE_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=https://vibe.example.com
REGISTRATION_ENABLED=true
MAX_USERS=100
SYNC_EVENT_RETENTION_DAYS=30
SYNC_EVENT_MAX_PER_HOST=10000
WINDOWS_CLIENT_URL=https://github.com/demonrain/anytimevibe/releases/latest/download/AnytimeVibe-Agent-Setup.exe
MAC_CLIENT_URL=https://github.com/demonrain/anytimevibe/releases/latest/download/AnytimeVibe-Agent.dmg
UPDATE_FEED_URL=https://github.com/demonrain/anytimevibe/releases/latest/download
# Optional standalone HTTPS update transfer server (configure after deployment succeeds).
UPDATE_TRANSFER_URL=
NPM_REGISTRY_ORIGIN=https://registry.npmjs.org
UPDATE_CACHE_DIR=
# Authenticated HTTPS native update proxy. The signing secret is shared with that service.
UPDATE_PROXY_URL=
UPDATE_PROXY_TOKEN_SECRET=
# Used by docker-compose.update.yml on the standalone machine.
UPDATE_DOMAIN=updates.example.com
UPDATE_PROXY_CERT_DIR=./update-proxy-certs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
